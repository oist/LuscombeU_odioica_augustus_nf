/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

// Environment modules used by Augustus-side tools (no container)
def AUGUSTUS_MODULE_LOAD = 'ml use /apps/unit/LuscombeU/.modulefiles/; ml load augustus/3.3.3_oiko; ml load minimap2; ml load samtools'

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // -------------------------------------------------------------------------
    // Augustus-side modules — use environment modules, no container
    // -------------------------------------------------------------------------

    // Decompress the (gzipped, soft-masked) genome before AUGUSTUS. Intermediate only.
    withName: '.*:AUGUSTUS_PREDICTION:GUNZIP_SAFE' {
        publishDir = [ enabled: false ]
    }

    withName: 'MINIMAP2_ALIGN_SORT' {
        beforeScript = AUGUSTUS_MODULE_LOAD
        publishDir   = [
            path: { "${params.outdir}/bam" },
            mode: params.publish_dir_mode,
            pattern: "*.bam"
        ]
    }

    withName: 'SAMTOOLS_INDEX' {
        beforeScript = AUGUSTUS_MODULE_LOAD
        publishDir   = [
            path: { "${params.outdir}/bam" },
            mode: params.publish_dir_mode,
            pattern: "*.bai"
        ]
    }

    withName: 'BAM2HINTS' {
        beforeScript = AUGUSTUS_MODULE_LOAD
        publishDir   = [
            path: { "${params.outdir}/hints" },
            mode: params.publish_dir_mode,
            pattern: "*.hints.gff"
        ]
    }

    withName: 'AUGUSTUS' {
        beforeScript = AUGUSTUS_MODULE_LOAD
        publishDir   = [
            path: { "${params.outdir}/augustus" },
            mode: params.publish_dir_mode,
            pattern: "*.gff3"
        ]
    }

    withName: 'GETANNOFASTA' {
        beforeScript = AUGUSTUS_MODULE_LOAD
        publishDir   = [
            path: { "${params.outdir}/augustus" },
            mode: params.publish_dir_mode,
            pattern: "*.{aa,codingseq}"
        ]
    }

    // -------------------------------------------------------------------------
    // AGAT sanitization modules — Singularity container
    // Intermediate AGAT products are not published; only the two final formatted
    // GFF3 files (see GFF_FORMAT_* below) are exposed to the user.
    // -------------------------------------------------------------------------

    withName: 'AGAT_FILTERINCOMPLETE' {
        publishDir = [ enabled: false ]
    }

    withName: 'AGAT_FLAGPREMATURESTOP' {
        publishDir = [ enabled: false ]
    }

    withName: 'AGAT_FILTERPSEUDO' {
        publishDir = [ enabled: false ]
    }

    withName: 'AGAT_KEEPLONGESTISOFORM' {
        publishDir = [ enabled: false ]
    }

    // -------------------------------------------------------------------------
    // Final GFF3 formatting — publish only these two files:
    //   ID.gff3                  (all proper-ORF genes, every valid isoform)
    //   ID_longest_isoform.gff3  (one isoform per gene)
    // -------------------------------------------------------------------------

    withName: '.*:GFF_SANITIZATION:GFF_FORMAT_ALL' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/gff" },
            mode: params.publish_dir_mode,
            pattern: "*.gff3"
        ]
    }

    withName: '.*:GFF_SANITIZATION:GFF_FORMAT_LONGEST' {
        ext.prefix = { "${meta.id}_longest_isoform" }
        publishDir = [
            path: { "${params.outdir}/gff" },
            mode: params.publish_dir_mode,
            pattern: "*.gff3"
        ]
    }

    // -------------------------------------------------------------------------
    // Repeat masking modules (REPEAT_MASKING subworkflow) — containers
    // -------------------------------------------------------------------------

    withName: '.*:REPEAT_MASKING:GUNZIP' {
        publishDir = [ enabled: false ]
    }

    withName: '.*:REPEAT_MASKING:TANTAN_MASK' {
        publishDir = [
            path: { "${params.outdir}/repeatmasking/tantan" },
            mode: params.publish_dir_mode,
            pattern: "*.masked.fa.gz"
        ]
    }

    withName: '.*:REPEAT_MASKING:WINDOWMASKER_MASK' {
        publishDir = [
            path: { "${params.outdir}/repeatmasking/windowmasker" },
            mode: params.publish_dir_mode,
            pattern: "*.masked.fa.gz"
        ]
    }

    withName: '.*:REPEAT_MASKING:REPEATMODELER_BUILDDATABASE' {
        ext.prefix = { "${meta.id}.stl_repeatmodeler_db" }
        publishDir = [ enabled: false ]
    }

    withName: '.*:REPEAT_MASKING:REPEATMODELER_REPEATMODELER' {
        ext.prefix = { "${meta.id}.stl_repeatmodeler" }
        publishDir = [
            path: { "${params.outdir}/repeatmasking/repeatmodeler" },
            mode: params.publish_dir_mode,
            pattern: "*.{fa,stk,log}"
        ]
    }

    withName: '.*:REPEAT_MASKING:REPEATMODELER_REPEATMASKER' {
        publishDir = [
            path: { "${params.outdir}/repeatmasking/repeatmasker" },
            mode: params.publish_dir_mode,
            pattern: "*.{masked.fa.gz,gff,tbl,html}"
        ]
    }

    withName: '.*:REPEAT_MASKING:.*_BED' {
        publishDir = [ enabled: false ]
    }

    withName: '.*:REPEAT_MASKING:MERGEDMASKS_ALL' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/repeatmasking" },
            mode: params.publish_dir_mode,
            pattern: "*_allmaskers.fasta.gz"
        ]
    }

}
